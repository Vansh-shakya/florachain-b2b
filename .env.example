d# ==============================================================================
# FloraChain B2B — Environment Configuration Template
# Copy this file to '.env' for local development:
#   cp .env.example .env
# Never commit '.env' or real credentials into version control.
# ==============================================================================

# Flask Core Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-cryptographically-secure-random-string-in-production

# Security & RBAC Configuration
# Set to 'false' in production. In local development ('true'), allows switching demo roles via /api/auth/switch-role
FLORACHAIN_ALLOW_DEMO_ROLE_SWITCH=true

# Database Configuration
# Default: SQLite file at data/florachain.db (leave DATABASE_URL unset/commented for SQLite)
# FLORACHAIN_DB_PATH=data/florachain.db

# Optional: PostgreSQL Database Connection String
# When set, the application automatically uses the PostgreSQL dual-engine adapter.
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/florachain_test

# Test Database Connection (Used only by integration tests)
# TEST_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/florachain_test

# Centralized Logging Configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
